# === Portal Kampus (contoh: UMBY SSO) ===
PORTAL_URL=https://sso.mercubuana-yogya.ac.id
PORTAL_USERNAME=nim_anda
PORTAL_PASSWORD=password_anda

PORTAL_SELECTOR_USERNAME=input[name="username"]
PORTAL_SELECTOR_PASSWORD=input[name="password"]
PORTAL_SELECTOR_SUBMIT=#login-btn
PORTAL_SELECTOR_OTP_INPUT=
PORTAL_SELECTOR_OTP_SUBMIT=button[type="submit"], #login-btn

ELEARNING_URL=https://sso.mercubuana-yogya.ac.id/redirect/e-learning-portal
ELEARNING_SELECTOR=#region-main, .block_timeline, .block_myoverview, #block-region-content
ELEARNING_MAX_COURSES=12

# === Magic link email (Gmail) ===
GMAIL_OTP_FROM=noreply@umby.ac.id
GMAIL_OTP_SUBJECT=Two Step Verification
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json
GMAIL_TOKEN_PATH=./credentials/gmail-token.json

# === Google Sheets ===
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_TAB=Sheet1

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=

# === Runtime ===
PLAYWRIGHT_TIMEOUT=90000
OTP_WAIT_MS=180000
OTP_POLL_INTERVAL_MS=4000
OTP_DETECT_MS=45000
PLAYWRIGHT_HEADLESS=true
# Kosongkan di GitHub Actions (pakai Chromium). Lokal Windows boleh: msedge
PLAYWRIGHT_CHANNEL=
AUTH_STATE_PATH=./credentials/auth-state.json
AUTH_REUSE=true
ELEARNING_MAX_COURSES=12
ELEARNING_MAX_SECTIONS=10
